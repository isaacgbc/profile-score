# ProfileScore.io — environment variables template.
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ─────────────────────────────────────────────────────────────────────────────
# Database — Supabase PostgreSQL via PgBouncer
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://user:pass@host:5432/postgres

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — Auth + Storage
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─────────────────────────────────────────────────────────────────────────────
# Anthropic Claude
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_QUALITY=claude-sonnet-4-5

# ─────────────────────────────────────────────────────────────────────────────
# Admin access
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_SECRET=change-me-to-a-long-random-string
ADMIN_ALLOWLIST_EMAILS=you@example.com,teammate@example.com

# ─────────────────────────────────────────────────────────────────────────────
# Creala payments
# ─────────────────────────────────────────────────────────────────────────────
CREALA_WEBHOOK_SECRET=change-me-creala-hmac-secret

# ─────────────────────────────────────────────────────────────────────────────
# Apify LinkedIn Integration (Phase 01)
# ─────────────────────────────────────────────────────────────────────────────
# Personal API token from https://console.apify.com/account/integrations
# MUST start with "apify_api_" and be exactly 46 characters — do NOT wrap in
# angle brackets or quotes when copying into .env.local.
APIFY_API_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxx
# 32-byte random hex — used to salt anonymous-user fingerprint hashes for
# free-tier quota tracking. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APIFY_FINGERPRINT_SALT=change-me-to-64-byte-random-hex
# Emergency kill switch: set to "false" to disable /api/scrape-linkedin
# without a redeploy. Defaults to "true".
APIFY_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://profilescore.io

# ─────────────────────────────────────────────────────────────────────────────
# Feature flags (optional overrides)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_PAYMENTS_ENABLED=true
NEXT_PUBLIC_ADMIN_BYPASS=false
ENABLE_PROGRESSIVE_GENERATION=true
NEXT_PUBLIC_ENABLE_PROGRESSIVE=true
ENABLE_PROGRESS_REGISTRY=true
NEXT_PUBLIC_USE_POLL_PROGRESS=false
ENABLE_ENTRY_SCORING=true
ENABLE_STRUCTURING_PASS=true
